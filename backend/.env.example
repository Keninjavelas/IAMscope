NODE_ENV=development
PORT=4000
MONGO_IDENTITY_URL=mongodb://localhost:27017/iamscope_identity?replicaSet=rs0
MONGO_DATA_URL=mongodb://localhost:27017/iamscope_data?replicaSet=rs0
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-me
CSRF_SECRET=replace-me
LOG_LEVEL=debug
# Optional override. Defaults to `package.json`'s version, which is what /api/health and
# every log line report. Set it only to label a build that is not the released version
# (a preview deploy, say) - otherwise leave it unset so the two cannot drift.
# APP_VERSION=
# Optional: minutes of inactivity before a session is considered idle-expired (0 = disabled)
SESSION_IDLE_MINUTES=0
# Optional: session + CSRF cookie SameSite policy.
#   lax  (default) - first-party only. Correct when the SPA reaches the API through the
#                    Vercel rewrite, which makes every call same-origin.
#   none           - required only if VITE_API_URL points at an absolute cross-origin API
#                    URL. Also needs HTTPS and is blocked by Safari ITP.
COOKIE_SAMESITE=lax
