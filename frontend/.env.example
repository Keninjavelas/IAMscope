# SSE transport.
#   cookie (default) - same-origin EventSource; the session cookie is sent automatically.
#   token            - mint a 5-minute HMAC token via POST /api/events/token, then connect
#                      straight to VITE_RENDER_URL. Only needed if Vercel's edge buffers the
#                      cookie-mode stream; the token appears in the URL, which proxies log
#                      (see DECISIONS D24).
VITE_SSE_MODE=cookie

# Origin of the API when it is reached directly. Required only when VITE_SSE_MODE=token -
# the app refuses to build with `token` and no URL set.
VITE_RENDER_URL=

# Leave empty to call the API on the same origin (`/api`), which is the default:
#  - dev  -> Vite proxy forwards /api to http://localhost:4000
#  - prod -> the Vercel rewrite in vercel.json forwards /api to the Render service
# Set this to an absolute URL only when the API lives on a different origin.
VITE_API_URL=
# Only used by `npm run dev` to point the proxy somewhere other than localhost:4000
VITE_DEV_API_TARGET=http://localhost:4000
