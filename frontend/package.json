{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IAMScope web client - React 18 + Vite 5 + Tailwind v4 + Radix. Deployed on Vercel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 3000 --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "a11y": "pa11y-ci --config ../.pa11yci.json"
  },
